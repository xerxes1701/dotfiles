nvim/.config/nvim/pending-updates/
# Generated by scripts/nu-regen-init.nu -- machine-local, deliberately untracked.
# These land here rather than under ~ because ~/.config/nushell is a stow
# symlink back into this repo, so the generator's writes resolve into the tree.
nushell/.config/nushell/zoxide.nu
nushell/.config/nushell/autoload/

# Written by nushell itself on every exit -- $nu.history-path is derived from
# the config dir, which the stow symlink above resolves into this repo.
nushell/.config/nushell/history.txt
