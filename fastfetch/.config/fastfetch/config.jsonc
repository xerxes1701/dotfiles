// Slim fastfetch config for narrow (split) monitors.
// Uses the small builtin logo and a trimmed set of modules.
// Delete this file to fall back to the CachyOS default.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        {
            "type": "break"
        },
        "colors"
    ]
}
