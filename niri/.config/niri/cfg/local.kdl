// ────────────── Local Overrides ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Include
//
// Every other file in cfg/ (but display.kdl) is kept exactly as
// cachyos-niri-noctalia ships it in /etc/skel/.config/niri. This one is
// included last, so a bind here replaces the one with the same keys, a
// section here only changes the fields it sets, and spawn-at-startup lines
// are added to the ones before.

spawn-at-startup "wl-clip-persist" "--clipboard" "regular"

// Since GTK 4.20, GTK apps on Wayland leave dead keys and compose sequences
// to an input method (IBus, fcitx) and type nothing when none runs, as here.
// "simple" is GTK's own handling, which reads ~/.XCompose. Replace it with
// "ibus" or "fcitx" if one of those is ever installed.
environment {
    GTK_IM_MODULE "simple"
}

input {
    keyboard {
        xkb {
            // Two layouts that differ only in dead keys: plain US, and US
            // international, where ' " ` ~ ^ wait for the next key (" a is ä).
            // Mod+D switches between them; noctalia's keyboard_layout widget
            // shows which one is on, see ~/.config/noctalia/keyboard.toml
            layout "us,us"
            variant ",intl"
            options "corne:f13" // F13-F24 on the corne, see ~/.config/xkb
        }
    }
}

binds {
    Mod+Return                          hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty"; }
    Mod+Space                           hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+V                               hotkey-overlay-title="Clipboard History: noctalia" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+D                               hotkey-overlay-title="Dead Keys On/Off: switch keyboard layout" { switch-layout "next"; }

    // The h/l twins of the monitor arrow binds, like Mod+H and Mod+CTRL+H for columns
    Mod+Shift+H                         { focus-monitor-left; }
    Mod+Shift+L                         { focus-monitor-right; }
    Mod+Shift+CTRL+H                    { move-column-to-monitor-left; }
    Mod+Shift+CTRL+L                    { move-column-to-monitor-right; }

    // The wheel follows the keys: up is H, down is L, and the modifiers mean
    // what they mean there -- CTRL moves, Shift is the monitor level. These
    // replace the shipped wheel binds; scrolling over noctalia's workspaces
    // widget without Mod is Mod+H/L too, see ~/.config/noctalia/bar.toml
    Mod+WheelScrollUp                   { focus-column-left; }
    Mod+WheelScrollDown                 { focus-column-right; }
    Mod+CTRL+WheelScrollUp              { move-column-left; }
    Mod+CTRL+WheelScrollDown            { move-column-right; }
    Mod+Shift+WheelScrollUp             cooldown-ms=150 { focus-monitor-left; }
    Mod+Shift+WheelScrollDown           cooldown-ms=150 { focus-monitor-right; }
    Mod+Shift+CTRL+WheelScrollUp        cooldown-ms=150 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+WheelScrollDown      cooldown-ms=150 { move-column-to-monitor-right; }

    // ALT is the workspace level, whose axis is vertical: K and the wheel up go
    // up, J and the wheel down go down. Mod+ALT+L stays the lock screen.
    Mod+ALT+K                           { focus-workspace-up; }
    Mod+ALT+J                           { focus-workspace-down; }
    Mod+ALT+CTRL+K                      { move-column-to-workspace-up; }
    Mod+ALT+CTRL+J                      { move-column-to-workspace-down; }
    Mod+ALT+WheelScrollUp               cooldown-ms=150 { focus-workspace-up; }
    Mod+ALT+WheelScrollDown             cooldown-ms=150 { focus-workspace-down; }
    Mod+ALT+CTRL+WheelScrollUp          cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+ALT+CTRL+WheelScrollDown        cooldown-ms=150 { move-column-to-workspace-down; }

    Mod+M                             { maximize-column; }
    Mod+Shift+M                         { set-column-width "50%"; }

    Mod+F                               { maximize-window-to-edges; } // Fills the screen but stays in the layout, so window opacity still shows the wallpaper
    Mod+CTRL+M                          hotkey-overlay-title="Stack: maximize window, float the one to its right on top" { spawn-sh "~/.config/niri/scripts/stack-right-on-maximized.sh"; }
}

// Satisfactory without gamescope: what gamescope's -W/-H/-f did.
// Proton names its X11 windows steam_app_<appid>; gamescope's own window is
// app-id "gamescope", so this does nothing while the game still runs in it.
window-rule {
    match app-id="^steam_app_526870$"
    open-on-output "DP-3"
    open-fullscreen true
    geometry-corner-radius 0
    clip-to-geometry false
}
