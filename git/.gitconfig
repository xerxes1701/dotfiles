[user]
  email = michaelgawlik1983@gmail.com
	name = Michael Gawlik

[core]
	pager = delta
	longpaths = true
	checkStat = minimal
	trustctime = false
	untrackedCache = true
	preloadIndex = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# claude code's settings.json in the dotfiles repository, as git sees it (its
# .gitattributes names the file): "model" pinned to opus, "modelSettings" --
# the effort /effort saves per model -- dropped, and the keys sorted, since a
# rewrite moves them about. The file on disk keeps what claude code wrote. No
# smudge, so a checkout writes the file as committed. Not required: without jq
# git warns and sees the file as it is.
[filter "claude-settings"]
	clean = jq -S '.model = \"opus\" | del(.modelSettings)'

[push]
	autoSetupRemote = true

# WSL: the Git Credential Manager of Git for Windows, so a login saved there
# is reused here. Only where that path exists: Git for Windows reads this file
# too (deploy-windows-noadmin.ps1), and there the helper does nothing and git
# falls through to the `manager` its own system config sets. Git for Windows
# 2.56 moved it from mingw64 to ucrt64; the old place is kept for older installs.
[credential]
	helper = "!f() { for gcm in '/mnt/c/Program Files/Git/ucrt64/bin/git-credential-manager.exe' '/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe'; do if [ -x \"$gcm\" ]; then exec \"$gcm\" \"$@\"; fi; done; }; f"

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true # use n and N to move between diff sections
	side-by-side = true

[diff]
	colorMoved = default

[merge]
	conflictStyle = zdiff3

[rebase]
	updateRefs = true

[alias]
	# The short names (s, d, b, w l, ...) and the bigger commands are al's:
	# al/.config/al/aliases/git.toml, run as `g`. What is left here is what
	# scripts and al's commands build on, and options preset.

	# --- default-branch helper: origin/HEAD, else origin/main, else origin/master ---
	main-branch = "!f() { d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); if [ -z \"$d\" ]; then for b in main master; do git show-ref --verify --quiet refs/remotes/origin/$b && d=origin/$b && break; done; fi; echo \"$d\"; }; f"
	bn   = branch --show-current
	root = rev-parse --show-toplevel

	# --- commands of al's own, so plain git runs and completes them too:
	# git del b -r, git main d, git review show. The fish completion is
	# fish/.config/fish/conf.d/al-git.fish. ---
	delete     = !al run git delete
	list       = !al run git list
	main       = !al run git main
	review     = !al run git review
	upstream   = !al run git upstream
	difftastic = !al run git difftastic
	zip-head   = !al run git zip-head
	# Their short forms, as in git.toml: git aliases may name another.
	del = delete
	li  = list
	mn  = main
	re  = review
	up  = upstream
	dt  = difftastic
	zip = zip-head

	# --- branches ---
	# Newest first, each branch marked: current or in another worktree, ahead
	# of or behind its upstream, upstream gone, merged into the main branch.
	# A pattern narrows the list. See git-brl.sh.
	brl  = !git-brl.sh
	# The same for the remote-tracking branches: the local branch ahead of
	# or behind each, or none; merged into the main branch. See git-brlr.sh.
	brlr = !git-brlr.sh

	# --- log formats ---
	lg  = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	lga = lg --all
	ls  = log --decorate --date=format:'%Y-%m-%d %H:%M' --pretty=format:'%C(bold blue)%h%C(reset) %C(bold green)%cd%C(reset) %C(dim white)[%cn]%C(reset) %C(white)%s%C(reset)%C(auto)%d%C(reset)'
	ll  = ls --numstat

	# --- options preset ---
	cm  = commit -m
	ca  = commit --amend
	cam = commit --amend -m
	dw  = diff --ignore-all-space
	phf = push --force-with-lease
	stm = stash push --message
	# Merge only by fast-forward; fails instead of creating a merge commit.
	# `g up ff` does that with the upstream.
	mff = merge --ff-only
	mc  = merge --continue
	ma  = merge --abort
	rbc = rebase --continue
	rba = rebase --abort

	# Before a force-push: does the rebased branch still make the changes its
	# pushed version made? A .NET file-based app; see git-verify-rebase.cs.
	# Run by its real path: dotnet run goes by the timestamp of the link stow
	# put in ~/.local/bin, and would keep running a stale build.
	verify-rebase = "!dotnet run --file \"$(readlink -f \"$HOME/.local/bin/git-verify-rebase.cs\")\" --"
	rbv = verify-rebase

# Machine-local: user.email and the platform-specific `fh`. Kept last so it wins.
[include]
	path = ~/.gitconfig.local
[gc]
	auto = 0
[http "https://gitlab.klafka-hinz.de/"]
	sslCAInfo = /usr/local/share/ca-certificates/klafka-hinz-ca-bundle.crt
[init]
	defaultBranch = main
