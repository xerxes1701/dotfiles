# Ghostty is the terminal bound to Mod+Return in niri.

command = /usr/bin/fish
shell-integration = fish

# Matches Alacritty's opacity = 0.8, so the semitransparent terminal
# stays readable over a maximized window (Mod+F / Mod+Ctrl+M).
background-opacity = 0.8

# The close-confirmation dialog defaults to "Cancel" and that isn't
# configurable, so closing via keyboard is awkward. Skip the dialog.
confirm-close-surface = false

# The Logitech mouse has a high-resolution wheel, so Ghostty treats it as a
# "precision" device and scrolls by pixels — much faster than Alacritty, which
# scrolls a fixed 3 lines per notch (scrolling.multiplier = 3). Damping the
# precision multiplier brings it back in line; discrete stays at Ghostty's
# default of 3, which already matches Alacritty.
mouse-scroll-multiplier = precision:0.05,discrete:1

# Settings that belong to one machine only go in config.local next to this
# file. It is optional, and loaded after this file, so its values win. WSL's
# overrides the scroll multiplier above: under WSLg the wheel reaches Ghostty
# as precision scrolling too, but in steps so small that 0.05 needs many
# notches per line.
config-file = ?config.local
