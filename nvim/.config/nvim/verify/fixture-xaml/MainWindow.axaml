<!-- Fixture for verify.sh. The Avalonia twin of MainWindow.xaml: .axaml must
     get the same xaml filetype, and with it everything that hangs off it. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fixture.MainWindow"
        Title="Fixture" Height="200" Width="300">
    <StackPanel Margin="8">
        <TextBlock Text="hello, world" />
        <Button Content="OK" Width="80" />
    </StackPanel>
</Window>
