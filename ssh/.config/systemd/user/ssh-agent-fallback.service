# One ssh-agent per user, started with the systemd user instance, so a key
# unlocked once (AddKeysToAgent in ~/.ssh/config) serves every later ssh --
# including the ones herdr starts in the background, which cannot show a
# passphrase prompt. Enable it once per machine, after deploying:
#
#   systemctl --user enable --now ssh-agent-fallback.service
#
# Only where nothing listens on that path yet. Arch's openssh, and so
# cachyos's, ships ssh-agent.socket, enabled by default, which listens on the
# same path and starts its own ssh-agent.service on the first connection.
# Debian's and Ubuntu's openssh ship an ssh-agent.socket too, but it listens on
# %t/openssh_agent, so the condition below asks for the path itself rather
# than for openssh's unit file. Socket units are bound before sockets.target,
# which every service waits for through basic.target, so on arch the path is
# there by the time the condition is checked. ssh-agent removes its socket
# when it stops; one killed outright leaves it behind, and this unit then
# stays down until /run/user is emptied at the next login.
#
# This unit used to be called ssh-agent.service as well: it replaced openssh's,
# was started by its socket, and could not bind the path the socket already
# held. Under a name of its own it leaves openssh's pair alone.
#
# Its socket is $XDG_RUNTIME_DIR/ssh-agent.socket (%t below), the same path as
# openssh's, and the shells export SSH_AUTH_SOCK for it when it exists. -D
# keeps the agent in the foreground, which is what Type=simple expects;
# ssh-agent lives at /usr/bin on Ubuntu and Arch alike.

[Unit]
Description=ssh-agent, where none listens on its socket yet
Documentation=man:ssh-agent(1)
ConditionPathExists=!%t/ssh-agent.socket

[Service]
Type=simple
ExecStart=/usr/bin/ssh-agent -D -a %t/ssh-agent.socket

[Install]
WantedBy=default.target
