{
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "enabledPlugins": {
    "nerd-glyphs@local-mods": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude/mods/paste-image:~/dotfiles/claude/mods/status-band:~/dotfiles/claude/mods/cls:~/dotfiles/claude/mods/code-fence:~/dotfiles/claude/mods/mermaid"
  },
  "extraKnownMarketplaces": {
    "local-mods": {
      "source": {
        "path": "/home/xerxes/.claude/local-marketplace",
        "source": "directory"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-band/statusline.mjs\" --reset-cursor",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus",
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "auto"
  },
  "skipWorkflowUsageWarning": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  },
  "statusLine": {
    "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/status-band/statusline.mjs\"",
    "hideVimModeIndicator": true,
    "padding": 0,
    "refreshInterval": 10,
    "type": "command"
  },
  "theme": "custom:prompt-pop",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
