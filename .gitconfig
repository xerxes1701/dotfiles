[user]
	email = michaelgawlik1983@gmail.com
	name = Michael Gawlik

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true # use n and N to move between diff sections
	side-by-side = true
	#dark = true
	#light = true
	
[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	root = rev-parse --show-toplevel
	fadd = "!fish -c \"cd (git root); git status --porcelain | rg '^( |\\?\\?)' | cut -c4- | fzf -m --preview 'git diff --color=always {}' | xargs git add; cd -\""
	x = !fish -c \"git status --porcelain | rg '^( |\\?\\?)'\"
	ffiles = "!fish -c \"cd (git root); git status --porcelain | rg '^( |\\?\\?)' | cut -c4- | fzf -m --preview 'git diff --color=always {}'; cd -\""
	undo = "!fish -c \"cd (git root); git status --porcelain | rg '^( |\\?\\?)' | cut -c4- | fzf -m --preview 'git diff --color=always {}' | xargs git checkout; cd -\""
