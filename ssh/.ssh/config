# ssh client config, stowed from ~/dotfiles/ssh. `ssh -G <target>` shows what
# applies to a target once every Host block has been matched.

# The key in ~/.ssh has a passphrase, and some of the connections made with it
# cannot ask for one: herdr's saved machines connect in the background, and
# `herdr --remote` runs ssh itself. So the first interactive ssh unlocks the key
# and hands it to the agent (ssh-agent.service, in this package; the shells
# point SSH_AUTH_SOCK at its socket), and every connection after that finds it
# there until the agent stops. Without an agent this is a no-op, and ssh asks
# for the passphrase every time, as before.
AddKeysToAgent yes

# The herdr server on the other linux pc. `herdr --remote <alias>` attaches a
# window here to its session, and `herdr machine add <alias> --label <name>`
# keeps it in the sidebar next to the local one. See "herdr on another
# machine" in the README. herdr wraps this file in a config of its own that
# adds keepalives, so none are set here.
Host hal-laptop
    HostName hal-laptop
    User xerxes

# ssh-add and the shells find the agent through SSH_AUTH_SOCK; ssh itself finds
# it here as well. It has to: this WSL distro logs in without pam_systemd, so
# XDG_RUNTIME_DIR is unset in every shell -- the export above never fires, and
# the herdr server inherited an environment without it. %i is the uid, so the
# path is the same one ssh-agent.service listens on (%t there). A socket that
# is not there is simply not used, exactly as before.
IdentityAgent /run/user/%i/ssh-agent.socket

# The ActivityTracer devcontainers, which docker compose publishes on loopback
# -- 2223 and 2224 rather than 2222, because Windows and WSL share one loopback
# and the Windows sshd already holds that port (see the project's
# .devcontainer/docker-compose.yml). These are the aliases
# `herdr machine add activitytracer-frontend` uses, so both containers' agents
# land in the sidebar next to the local ones.
#
# Generated equivalently by the project's scripts/host/ssh-setup.sh
# --write-ssh-config, which appends to ~/.ssh/config -- through this package's
# symlink, into this file. Written here by hand instead, so the block is in the
# repository rather than in a machine-local edit that stow would fight.
Host activitytracer-frontend
    HostName 127.0.0.1
    Port 2223
    User vscode
    # The containers are disposable, and their host key legitimately changes
    # with the ssh-hostkeys-* volumes, so a changed key here is never the MITM
    # signal it would be for a real host. Kept out of the main known_hosts for
    # that reason.
    UserKnownHostsFile ~/.ssh/known_hosts.activitytracer
    StrictHostKeyChecking accept-new
    ForwardAgent yes

Host activitytracer-backend
    HostName 127.0.0.1
    Port 2224
    User vscode
    UserKnownHostsFile ~/.ssh/known_hosts.activitytracer
    StrictHostKeyChecking accept-new
    ForwardAgent yes
