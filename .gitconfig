	email = michaelgawlik1983@gmail.com
	name = Michael Gawlik

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true # use n and N to move between diff sections
	side-by-side = true
	#dark = true
	#light = true
	
[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

